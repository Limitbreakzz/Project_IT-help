// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  TECHNICIAN
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[] @relation("UserTickets")
  assigned  Ticket[] @relation("TechnicianTickets")
}

model Ticket {
  id              String       @id @default(cuid())
  title           String
  description     String       @db.Text
  imageUrl        String?      @db.LongText
  status          TicketStatus @default(PENDING)
  priority        Priority     @default(MEDIUM)
  category        String?
  aiAnalysis      Json?        // Stores AI breakdown, cost estimate, time estimate
  costEstimateMin Float?
  costEstimateMax Float?
  timeEstimate    String?

  userId          String
  user            User         @relation("UserTickets", fields: [userId], references: [id])

  technicianId    String?
  technician      User?        @relation("TechnicianTickets", fields: [technicianId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model InventoryItem {
  id        String   @id @default(cuid())
  name      String   @unique
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
